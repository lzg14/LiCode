node_modules/
dist/
*.log
.env
.env.*
.env.local
*.key
*.pem
*.db
*.db-shm
*.db-wal
*.sublime-*
.DS_Store
Thumbs.db
.checkpoints/
# memory/  # 忽略 packages/memory 目录下的文件

# User data
memory/
tsc-result*.txt
test-results/

# 临时文件（只匹配仓库根，避免误伤源码中合理的 .tmp 命名）
/.tmp/
/tmp/
/.vscode/
/.licode/

# 调试日志（一次性运行产生的临时日志，避免被 *.log 全量误伤）
tsc-*.log
test-*.log
vitest-*.log

# Biome 运行产物
biome-*.txt

# Test coverage 报告（每次跑测试都会重新生成，不入 git）
coverage/
*.lcov
*.lcov.info

# Git 操作日志
git-restore.txt

# Subagent 工作脚本（一次性审计/迁移/rebump 工具，跑完不入版本管理）
/_chg/
